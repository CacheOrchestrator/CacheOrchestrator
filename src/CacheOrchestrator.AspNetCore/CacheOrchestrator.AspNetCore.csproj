<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>latest</LangVersion>
		<PackageId>CacheOrchestrator.AspNetCore</PackageId>
		<Description>ASP.NET Core integration for CacheOrchestrator: Output Cache, client Cache-Control, Admin API, and HTTP domain data-cache helpers.</Description>
		<PackageTags>cache;caching;domain;outputcache;datacache;httpcache;aspnetcore;cacheorchestrator</PackageTags>
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>logo-small.png</PackageIcon>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<ItemGroup>
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\docs\assets\logo-small.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\CacheOrchestrator.Core\CacheOrchestrator.Core.csproj" />
		<ProjectReference Include="..\CacheOrchestrator.Analyzers\CacheOrchestrator.Analyzers.csproj"
			PrivateAssets="all"
			ReferenceOutputAssembly="false"
			OutputItemType="Analyzer" />
	</ItemGroup>

	<!-- Embed analyzer into AspNetCore nupkg when the Analyzers project has been built. -->
	<ItemGroup>
		<None Include="..\CacheOrchestrator.Analyzers\bin\$(Configuration)\netstandard2.0\CacheOrchestrator.Analyzers.dll"
			Pack="true"
			PackagePath="analyzers/dotnet/cs"
			Visible="false" />
	</ItemGroup>

	<ItemGroup>
		<InternalsVisibleTo Include="CacheOrchestrator.AspNetCore.UnitTests" />
		<InternalsVisibleTo Include="CacheOrchestrator.IntegrationTests" />
		<InternalsVisibleTo Include="CacheOrchestrator.Redis.UnitTests" />
		<InternalsVisibleTo Include="CacheOrchestrator.AspNetCore.Redis.UnitTests" />
		<InternalsVisibleTo Include="CacheOrchestrator.AspNetCore.Redis" />
		<InternalsVisibleTo Include="CacheOrchestrator.HttpBus.UnitTests" />
		<InternalsVisibleTo Include="CacheOrchestrator.EFCore.Invalidation.UnitTests" />
		<InternalsVisibleTo Include="CacheOrchestrator.Benchmarks" />
		<InternalsVisibleTo Include="CacheOrchestrator.HttpBus" />
		<InternalsVisibleTo Include="CacheOrchestrator.Redis" />
		<InternalsVisibleTo Include="CacheOrchestrator.Edge" />
	</ItemGroup>
</Project>
