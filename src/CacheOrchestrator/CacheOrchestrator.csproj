<Project Sdk="Microsoft.NET.Sdk">
	<PropertyGroup>
		<TargetFrameworks>net8.0;net10.0</TargetFrameworks>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<PackageId>CacheOrchestrator</PackageId>
		<!-- Canonical short description — keep in sync with root README / NuGet / GitHub About -->
		<Description>Domain-based configuration and coordination for ASP.NET Core Output Cache, FusionCache, and client Cache-Control — not a cache of its own. Redis backends: install CacheOrchestrator.Redis.</Description>
		<PackageTags>cache;caching;domain;outputcache;fusioncache;httpcache;aspnetcore;performance</PackageTags>
		<!-- NuGet.org shows this file (not the root GitHub README — HTML/logo-friendly for GitHub only). -->
		<PackageReadmeFile>README.md</PackageReadmeFile>
		<PackageIcon>logo-small.png</PackageIcon>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>$(NoWarn);1591</NoWarn>
		<EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
	</PropertyGroup>

	<ItemGroup>
		<!-- Package readme: short markdown that renders cleanly on nuget.org -->
		<None Include="README.md" Pack="true" PackagePath="\" />
		<None Include="..\..\docs\assets\logo-small.png" Pack="true" PackagePath="\" />
	</ItemGroup>

	<!-- Meta package: AspNetCore + FusionCache with combined AddCacheOrchestrator. -->
	<ItemGroup>
		<ProjectReference Include="..\CacheOrchestrator.AspNetCore\CacheOrchestrator.AspNetCore.csproj" />
		<ProjectReference Include="..\CacheOrchestrator.FusionCache\CacheOrchestrator.FusionCache.csproj" />
	</ItemGroup>
</Project>
