<Project>
  <Import Project="eng/ReleaseProjects.props" />
  <PropertyGroup>
    <LangVersion>14.0</LangVersion>
    <Authors>Ales Marinsek</Authors>
    <Company>Ales Marinsek</Company>
    <Copyright>Copyright © 2026 Ales Marinsek</Copyright>
    <RepositoryUrl>https://github.com/CacheOrchestrator/CacheOrchestrator</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/CacheOrchestrator/CacheOrchestrator</PackageProjectUrl>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>

    <!--
      Versioning: MinVer derives PackageVersion / Version from Git tags.
      - Tag format: v1.0.0  (prefix "v" is stripped)
      - After v1.0.0, commits without a new tag become 1.0.1-rc.0.{height} (default pre-release)
      - Do NOT hardcode <Version> here — it would fight MinVer.
      Release process: CONTRIBUTING.md / docs/contributor/releasing.md
    -->
    <MinVerTagPrefix>v</MinVerTagPrefix>
    <MinVerMinimumMajorMinor>1.0</MinVerMinimumMajorMinor>
    <MinVerDefaultPreReleaseIdentifiers>rc.0</MinVerDefaultPreReleaseIdentifiers>

    <!--
      NuGet "Release Notes" tab: content is read from PACKAGE_RELEASE_NOTES.md
      (repo root, next to this file). Update that file before each release — see CONTRIBUTING.md.
      All packable library projects inherit the same notes.
    -->
    <PackageReleaseNotes>$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)PACKAGE_RELEASE_NOTES.md').Trim())</PackageReleaseNotes>

    <!--
      SourceLink + symbols (NuGet snupkg):
      - PublishRepositoryUrl: <repository> in the nupkg nuspec
      - EmbedUntrackedSources: include generated sources in PDB when needed
      - IncludeSymbols + snupkg: separate symbol package for nuget.org / debuggers
    -->
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
  </PropertyGroup>

  <PropertyGroup Condition="$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <PropertyGroup Condition="!$(MSBuildProjectDirectory.Replace('\', '/').Contains('/src/'))">
    <NoWarn>$(NoWarn);IDE0005</NoWarn>
  </PropertyGroup>

  <!-- Deterministic builds + correct SourceLink paths on GitHub Actions -->
  <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
    <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />
    <PackageReference Include="MinVer" Version="6.0.0" PrivateAssets="All" />
  </ItemGroup>

  <!-- Public API baselines are release contracts for every packable library. -->
  <PropertyGroup>
    <_PublicApiProjectNames>;$(ReleasePackageNames);</_PublicApiProjectNames>
    <_IsPublicApiProject>$([System.String]::Copy('$(_PublicApiProjectNames)').Contains(';$(MSBuildProjectName);'))</_IsPublicApiProject>
  </PropertyGroup>
  <PropertyGroup Condition="'$(_IsPublicApiProject)' == 'true'">
    <EnablePackageValidation>true</EnablePackageValidation>
    <EnableStrictModeForCompatibleTfms>true</EnableStrictModeForCompatibleTfms>
  </PropertyGroup>
  <ItemGroup Condition="'$(_IsPublicApiProject)' == 'true'">
    <PackageReference Include="Microsoft.CodeAnalysis.PublicApiAnalyzers" Version="5.6.0" PrivateAssets="All" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)eng/PublicApi/$(MSBuildProjectName)/PublicAPI.Shipped.txt" />
    <AdditionalFiles Include="$(MSBuildThisFileDirectory)eng/PublicApi/$(MSBuildProjectName)/PublicAPI.Unshipped.txt" />
  </ItemGroup>
</Project>
